// Métadonnées Windows d'ARXFUND.
// Compilé par build.rs avec windres (toolchain GNU) au moment du build release.

1 ICON "arxfund.ico"
1 24 "arxfund.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ARXFUND"
            VALUE "FileDescription", "ARXFUND - lecteur musical et studio de production"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "ARXFUND"
            VALUE "OriginalFilename", "ARXFUND.exe"
            VALUE "ProductName", "ARXFUND"
            VALUE "ProductVersion", "0.1.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 ARXFUND"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
